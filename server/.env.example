# Copy to .env and adjust as needed.
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/crest
CLIENT_ORIGIN=http://localhost:5173
# Secret used to sign JWTs — set a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Simulation tuning
TICK_MS=1400
VOLATILITY=1.2
MARKET_OPEN=true
