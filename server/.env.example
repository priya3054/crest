# Copy to .env and adjust as needed.
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/crest
REDIS_URL=redis://127.0.0.1:6379
CLIENT_ORIGIN=http://localhost:5173
# Process role: all (default) | producer | gateway
ROLE=all
# Secret used to sign JWTs — set a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Simulation tuning
TICK_MS=1400
VOLATILITY=1.2
# Market hours: auto = real NSE hours (Mon-Fri 09:15-15:30 IST),
# always = open 24/7 (good for demos), closed = force shut.
MARKET_HOURS=auto
